<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <!-- ── Accueil ─────────────────────────────────────────────────── -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.app_mythology.ui.home.HomeFragment"
        android:label="MythoBase"
        tools:layout="@layout/fragment_home">
        <action android:id="@+id/action_home_to_browseChoice"
            app:destination="@id/browseChoiceFragment" />
        <action android:id="@+id/action_home_to_addChoice"
            app:destination="@id/addChoiceFragment" />
        <action android:id="@+id/action_home_to_quizChoice"
            app:destination="@id/quizChoiceFragment" />
        <action android:id="@+id/action_home_to_achievements"
            app:destination="@id/achievementsFragment" />
    </fragment>

    <fragment
        android:id="@+id/achievementsFragment"
        android:name="com.example.app_mythology.ui.achievements.AchievementsFragment"
        android:label="Succès"
        tools:layout="@layout/fragment_achievements" />

    <!-- ── Parcourir ──────────────────────────────────────────────── -->
    <fragment
        android:id="@+id/browseChoiceFragment"
        android:name="com.example.app_mythology.ui.browse.BrowseChoiceFragment"
        android:label="Parcourir"
        tools:layout="@layout/fragment_browse_choice">
        <action android:id="@+id/action_browseChoice_to_entityList"
            app:destination="@id/entityListFragment" />
        <action android:id="@+id/action_browseChoice_to_placeList"
            app:destination="@id/placeListFragment" />
        <action android:id="@+id/action_browseChoice_to_artifactList"
            app:destination="@id/artifactListFragment" />
    </fragment>

    <fragment
        android:id="@+id/entityListFragment"
        android:name="com.example.app_mythology.ui.browse.EntityListFragment"
        android:label="Entités"
        tools:layout="@layout/fragment_entity_list">
        <action android:id="@+id/action_entityList_to_entityDetail"
            app:destination="@id/entityDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/entityDetailFragment"
        android:name="com.example.app_mythology.ui.browse.EntityDetailFragment"
        android:label="Détail"
        tools:layout="@layout/fragment_entity_detail">
        <argument android:name="entityId" app:argType="integer" android:defaultValue="-1" />
        <action android:id="@+id/action_entityDetail_to_entityDetail"
            app:destination="@id/entityDetailFragment"
            app:popUpTo="@id/entityListFragment"
            app:popUpToInclusive="false"/>
        <action android:id="@+id/action_entityDetail_to_editEntity"
            app:destination="@id/editEntityFragment" />
    </fragment>

    <fragment
        android:id="@+id/editEntityFragment"
        android:name="com.example.app_mythology.ui.add.EditEntityFragment"
        android:label="Modifier"
        tools:layout="@layout/fragment_add_entity">
        <argument android:name="entityId" app:argType="integer" android:defaultValue="-1" />
    </fragment>

    <fragment
        android:id="@+id/placeListFragment"
        android:name="com.example.app_mythology.ui.browse.PlaceListFragment"
        android:label="Lieux"
        tools:layout="@layout/fragment_place_list">
        <action android:id="@+id/action_placeList_to_placeDetail"
            app:destination="@id/placeDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/placeDetailFragment"
        android:name="com.example.app_mythology.ui.browse.PlaceDetailFragment"
        android:label="Lieu — Détail"
        tools:layout="@layout/fragment_place_detail">
        <argument android:name="placeId" app:argType="integer" android:defaultValue="-1" />
        <action android:id="@+id/action_placeDetail_to_editPlace"
            app:destination="@id/editPlaceFragment" />
    </fragment>

    <fragment
        android:id="@+id/editPlaceFragment"
        android:name="com.example.app_mythology.ui.add.EditPlaceFragment"
        android:label="Modifier lieu"
        tools:layout="@layout/fragment_add_place">
        <argument android:name="placeId" app:argType="integer" android:defaultValue="-1" />
    </fragment>

    <fragment
        android:id="@+id/artifactListFragment"
        android:name="com.example.app_mythology.ui.browse.ArtifactListFragment"
        android:label="Artéfacts"
        tools:layout="@layout/fragment_entity_list">
        <action android:id="@+id/action_artifactList_to_artifactDetail"
            app:destination="@id/artifactDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/artifactDetailFragment"
        android:name="com.example.app_mythology.ui.browse.ArtifactDetailFragment"
        android:label="Artéfact — Détail"
        tools:layout="@layout/fragment_artifact_detail">
        <argument android:name="artifactId" app:argType="integer" android:defaultValue="-1" />
        <action android:id="@+id/action_artifactDetail_to_editArtifact"
            app:destination="@id/editArtifactFragment" />
    </fragment>

    <fragment
        android:id="@+id/editArtifactFragment"
        android:name="com.example.app_mythology.ui.add.EditArtifactFragment"
        android:label="Modifier artéfact"
        tools:layout="@layout/fragment_add_artifact">
        <argument android:name="artifactId" app:argType="integer" android:defaultValue="-1" />
    </fragment>

    <!-- ── Ajouter ────────────────────────────────────────────────── -->
    <fragment
        android:id="@+id/addChoiceFragment"
        android:name="com.example.app_mythology.ui.add.AddChoiceFragment"
        android:label="Ajouter"
        tools:layout="@layout/fragment_add_choice">
        <action android:id="@+id/action_addChoice_to_addEntity"
            app:destination="@id/addEntityFragment" />
        <action android:id="@+id/action_addChoice_to_addPlace"
            app:destination="@id/addPlaceFragment" />
        <action android:id="@+id/action_addChoice_to_addArtifact"
            app:destination="@id/addArtifactFragment" />
    </fragment>

    <fragment
        android:id="@+id/addEntityFragment"
        android:name="com.example.app_mythology.ui.add.AddEntityFragment"
        android:label="Nouvelle entité"
        tools:layout="@layout/fragment_add_entity" />

    <fragment
        android:id="@+id/addPlaceFragment"
        android:name="com.example.app_mythology.ui.add.AddPlaceFragment"
        android:label="Nouveau lieu"
        tools:layout="@layout/fragment_add_place" />

    <fragment
        android:id="@+id/addArtifactFragment"
        android:name="com.example.app_mythology.ui.add.AddArtifactFragment"
        android:label="Nouvel artéfact"
        tools:layout="@layout/fragment_add_artifact" />

    <!-- ── Quiz ───────────────────────────────────────────────────── -->
    <fragment
        android:id="@+id/quizChoiceFragment"
        android:name="com.example.app_mythology.ui.quiz.QuizChoiceFragment"
        android:label="Quiz"
        tools:layout="@layout/fragment_quiz_choice">
        <action android:id="@+id/action_quizChoice_to_qcmDomain"
            app:destination="@id/qcmDomainChoiceFragment" />
        <action android:id="@+id/action_quizChoice_to_classicDomain"
            app:destination="@id/classicDomainChoiceFragment" />
        <action android:id="@+id/action_quizChoice_to_quizListChoice"
            app:destination="@id/quizListChoiceFragment" />
        <action android:id="@+id/action_quizChoice_to_quizHelp"
            app:destination="@id/quizHelpFragment" />
    </fragment>

    <!-- ── Choix du domaine (Entités / Artéfacts / Lieux) — par type de quiz ── -->
    <fragment
        android:id="@+id/qcmDomainChoiceFragment"
        android:name="com.example.app_mythology.ui.quiz.QuizDomainChoiceFragment"
        android:label="QCM"
        tools:layout="@layout/fragment_quiz_domain_choice">
        <argument android:name="quizMode" app:argType="string" android:defaultValue="qcm" />
        <action android:id="@+id/action_domain_to_entity"
            app:destination="@id/quizEntityQcmChoiceFragment" />
        <action android:id="@+id/action_domain_to_artifact"
            app:destination="@id/quizArtifactQcmChoiceFragment" />
    </fragment>

    <fragment
        android:id="@+id/classicDomainChoiceFragment"
        android:name="com.example.app_mythology.ui.quiz.QuizDomainChoiceFragment"
        android:label="Classique"
        tools:layout="@layout/fragment_quiz_domain_choice">
        <argument android:name="quizMode" app:argType="string" android:defaultValue="classic" />
        <action android:id="@+id/action_domain_to_entity"
            app:destination="@id/quizEntityChoiceFragment" />
        <action android:id="@+id/action_domain_to_artifact"
            app:destination="@id/quizArtifactChoiceFragment" />
        <action android:id="@+id/action_domain_to_place"
            app:destination="@id/quizPlaceChoiceFragment" />
    </fragment>

    <!-- ── QCM — entités et artéfacts ─────────────────────────────────── -->
    <fragment
        android:id="@+id/quizEntityQcmChoiceFragment"
        android:name="com.example.app_mythology.ui.quiz.QuizQcmChoiceFragment"
        android:label="Difficulté"
        tools:layout="@layout/fragment_quiz_entity_choice">
        <argument android:name="quizType" app:argType="string" android:defaultValue="entity" />
        <action android:id="@+id/action_qcmChoice_to_qcm"
            app:destination="@id/quiz_entity_qcm_graph" />
    </fragment>

    <navigation android:id="@+id/quiz_entity_qcm_graph"
        app:startDestination="@id/quizEntityQcmFragment">

        <fragment
            android:id="@+id/quizEntityQcmFragment"
            android:name="com.example.app_mythology.ui.quiz.QuizEntityQcmFragment"
            android:label="QCM Entités"
            tools:layout="@layout/fragment_quiz_qcm">
            <argument android:name="level" app:argType="string" android:defaultValue="easy" />
            <action android:id="@+id/action_qcmEntity_to_qcmEntityResult"
                app:destination="@id/quizEntityQcmResultFragment" />
        </fragment>

        <fragment
            android:id="@+id/quizEntityQcmResultFragment"
            android:name="com.example.app_mythology.ui.quiz.QuizEntityQcmResultFragment"
            android:label="Résultat"
            tools:layout="@layout/fragment_quiz_result" />

    </navigation>

    <fragment
        android:id="@+id/quizArtifactQcmChoiceFragment"
        android:name="com.example.app_mythology.ui.quiz.QuizQcmChoiceFragment"
        android:label="Difficulté"
        tools:layout="@layout/fragment_quiz_entity_choice">
        <argument android:name="quizType" app:argType="string" android:defaultValue="artifact" />
        <action android:id="@+id/action_qcmChoice_to_qcm"
            app:destination="@id/quiz_artifact_qcm_graph" />
    </fragment>

    <navigation android:id="@+id/quiz_artifact_qcm_graph"
        app:startDestination="@id/quizArtifactQcmFragment">

        <fragment
            android:id="@+id/quizArtifactQcmFragment"
            android:name="com.example.app_mythology.ui.quiz.QuizArtifactQcmFragment"
            android:label="QCM Artéfacts"
            tools:layout="@layout/fragment_quiz_qcm">
            <argument android:name="level" app:argType="string" android:defaultValue="easy" />
            <action android:id="@+id/action_qcmArtifact_to_qcmArtifactResult"
                app:destination="@id/quizArtifactQcmResultFragment" />
        </fragment>

        <fragment
            android:id="@+id/quizArtifactQcmResultFragment"
            android:name="com.example.app_mythology.ui.quiz.QuizArtifactQcmResultFragment"
            android:label="Résultat"
            tools:layout="@layout/fragment_quiz_result" />

    </navigation>

    <!-- ── Liste — thème choisi ───────────────────────────────────────── -->
    <fragment
        android:id="@+id/quizListChoiceFragment"
        android:name="com.example.app_mythology.ui.quiz.QuizListChoiceFragment"
        android:label="Quiz Liste"
        tools:layout="@layout/fragment_quiz_list_choice">
        <action android:id="@+id/action_quizListChoice_to_quizList"
            app:destination="@id/quizListFragment" />
    </fragment>

    <fragment
        android:id="@+id/quizListFragment"
        android:name="com.example.app_mythology.ui.quiz.QuizListFragment"
        android:label="Quiz Liste"
        tools:layout="@layout/fragment_quiz_list">
        <argument android:name="themeId" app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/quizHelpFragment"
        android:name="com.example.app_mythology.ui.quiz.QuizHelpFragment"
        android:label="Aide — Quiz"
        tools:layout="@layout/fragment_quiz_help" />

    <fragment
        android:id="@+id/quizEntityChoiceFragment"
        android:name="com.example.app_mythology.ui.quiz.QuizEntityChoiceFragment"
        android:label="Difficulté"
        tools:layout="@layout/fragment_quiz_entity_choice">
        <action android:id="@+id/action_quizEntityChoice_to_quizEntity"
            app:destination="@id/quiz_entity_graph" />
    </fragment>

    <navigation android:id="@+id/quiz_entity_graph"
        app:startDestination="@id/quizEntityFragment">

        <fragment
            android:id="@+id/quizEntityFragment"
            android:name="com.example.app_mythology.ui.quiz.QuizEntityFragment"
            android:label="Quiz Entités"
            tools:layout="@layout/fragment_quiz_entity">
            <argument android:name="level" app:argType="string" android:defaultValue="easy" />
            <action android:id="@+id/action_quizEntity_to_quizEntityResult"
                app:destination="@id/quizEntityResultFragment" />
        </fragment>

        <fragment
            android:id="@+id/quizEntityResultFragment"
            android:name="com.example.app_mythology.ui.quiz.QuizEntityResultFragment"
            android:label="Résultat"
            tools:layout="@layout/fragment_quiz_result" />

    </navigation>

    <fragment
        android:id="@+id/quizPlaceChoiceFragment"
        android:name="com.example.app_mythology.ui.quiz.QuizPlaceChoiceFragment"
        android:label="Quiz Lieux"
        tools:layout="@layout/fragment_quiz_place_choice">
        <action android:id="@+id/action_quizPlaceChoice_to_quizYggdrasil"
            app:destination="@id/quizYggdrasilFragment" />
        <action android:id="@+id/action_quizPlaceChoice_to_quizRivers"
            app:destination="@id/quizRiversFragment" />
        <action android:id="@+id/action_quizPlaceChoice_to_quizUnderworld"
            app:destination="@id/quizUnderworldFragment" />
    </fragment>

    <fragment
        android:id="@+id/quizYggdrasilFragment"
        android:name="com.example.app_mythology.ui.quiz.QuizPlaceFragment"
        android:label="Arbre Monde"
        tools:layout="@layout/fragment_quiz_place">
        <argument android:name="quizType" app:argType="string" android:defaultValue="yggdrasil" />
    </fragment>

    <fragment
        android:id="@+id/quizRiversFragment"
        android:name="com.example.app_mythology.ui.quiz.QuizPlaceFragment"
        android:label="Fleuves de l'Enfer"
        tools:layout="@layout/fragment_quiz_place">
        <argument android:name="quizType" app:argType="string" android:defaultValue="rivers" />
    </fragment>

    <fragment
        android:id="@+id/quizUnderworldFragment"
        android:name="com.example.app_mythology.ui.quiz.QuizPlaceFragment"
        android:label="Royaume des Morts"
        tools:layout="@layout/fragment_quiz_place">
        <argument android:name="quizType" app:argType="string" android:defaultValue="underworld" />
    </fragment>

    <fragment
        android:id="@+id/quizArtifactChoiceFragment"
        android:name="com.example.app_mythology.ui.quiz.QuizArtifactChoiceFragment"
        android:label="Difficulté"
        tools:layout="@layout/fragment_quiz_entity_choice">
        <action android:id="@+id/action_quizArtifactChoice_to_quizArtifact"
            app:destination="@id/quiz_artifact_graph" />
    </fragment>

    <navigation android:id="@+id/quiz_artifact_graph"
        app:startDestination="@id/quizArtifactFragment">

        <fragment
            android:id="@+id/quizArtifactFragment"
            android:name="com.example.app_mythology.ui.quiz.QuizArtifactFragment"
            android:label="Quiz Artéfacts"
            tools:layout="@layout/fragment_quiz_entity">
            <argument android:name="level" app:argType="string" android:defaultValue="easy" />
            <action android:id="@+id/action_quizArtifact_to_quizArtifactResult"
                app:destination="@id/quizArtifactResultFragment" />
        </fragment>

        <fragment
            android:id="@+id/quizArtifactResultFragment"
            android:name="com.example.app_mythology.ui.quiz.QuizArtifactResultFragment"
            android:label="Résultat"
            tools:layout="@layout/fragment_quiz_result" />

    </navigation>

</navigation>
