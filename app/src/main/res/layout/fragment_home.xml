<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mythos"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@color/on_surface"
            android:layout_marginBottom="64dp"/>

        <Button
            android:id="@+id/btn_browse"
            android:backgroundTint="@color/primary" android:textColor="@color/on_primary"
            android:layout_width="240dp"
            android:layout_height="56dp"
            android:text="📖  Données"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btn_quiz"
            android:backgroundTint="@color/primary" android:textColor="@color/on_primary"
            android:layout_width="240dp"
            android:layout_height="56dp"
            android:text="🎯  Quizz"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btn_duel"
            android:backgroundTint="@color/primary" android:textColor="@color/on_primary"
            android:layout_width="240dp"
            android:layout_height="56dp"
            android:text="⚔️  Duel"/>

    </LinearLayout>

    <!-- Version de l'application, coin supérieur gauche (renseignée à l'exécution
         depuis versionName, jamais codée en dur). Remplace l'ancienne icône Duel. -->
    <TextView android:id="@+id/tv_version"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|start" android:layout_margin="16dp"
        android:textColor="@color/on_surface_variant"
        android:textSize="13sp"
        android:contentDescription="Version de l'application"/>

    <TextView android:id="@+id/btn_trophy"
        android:layout_width="40dp" android:layout_height="40dp"
        android:layout_gravity="top|end" android:layout_margin="16dp"
        android:background="@drawable/bg_help_button"
        android:gravity="center"
        android:text="🏆" android:textSize="18sp"
        android:contentDescription="Succès"
        android:clickable="true" android:focusable="true"/>

</FrameLayout>
