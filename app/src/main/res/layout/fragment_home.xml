<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/surface">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="64dp"
        android:text="Mythos"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="@color/on_surface"/>

    <!-- Colonne des 3 boutons principaux : toujours incluse centrée, sans
         marge, pour un placement identique au pixel sur tous les écrans. -->
    <include layout="@layout/view_primary_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"/>

    <!-- Version de l'application, coin supérieur gauche (renseignée à
         l'exécution depuis versionName, jamais codée en dur). -->
    <TextView android:id="@+id/tv_version"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|start" android:layout_margin="16dp"
        android:textColor="@color/on_surface_variant"
        android:textSize="13sp"
        android:contentDescription="Version de l'application"/>

    <TextView android:id="@+id/btn_trophy"
        android:layout_width="40dp" android:layout_height="40dp"
        android:layout_gravity="top|end" android:layout_margin="16dp"
        android:background="@drawable/bg_help_button"
        android:gravity="center"
        android:text="🏆" android:textSize="18sp"
        android:contentDescription="Succès"
        android:clickable="true" android:focusable="true"/>

</FrameLayout>
