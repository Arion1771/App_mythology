<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/surface">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="72dp"
        android:text="Choisissez un quiz"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/on_surface"/>

    <include layout="@layout/view_primary_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"/>

    <TextView android:id="@+id/btn_quiz_help"
        android:layout_width="40dp" android:layout_height="40dp"
        android:layout_gravity="top|end" android:layout_margin="16dp"
        android:background="@drawable/bg_help_button"
        android:gravity="center"
        android:text="?" android:textSize="18sp" android:textStyle="bold"
        android:textColor="@color/primary"
        android:contentDescription="Aide sur les quiz"
        android:clickable="true" android:focusable="true"/>

</FrameLayout>
