<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/surface">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">

        <TextView android:id="@+id/tv_difficulty_badge"
            android:layout_width="36dp" android:layout_height="36dp"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:textSize="16sp" android:textStyle="bold"
            android:textColor="#FF1A1A1A"
            android:background="@drawable/dot_neutral"
            android:layout_marginBottom="12dp"/>

        <HorizontalScrollView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:scrollbars="none" android:layout_marginBottom="12dp">
            <LinearLayout android:id="@+id/dots_container"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal"/>
        </HorizontalScrollView>

        <TextView android:id="@+id/tv_quiz_progress"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="13sp" android:textColor="#FF9E9E9E"
            android:layout_marginBottom="16dp"/>

        <TextView android:id="@+id/tv_quiz_mythology"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="16sp" android:textColor="#FFEAEAEA"
            android:layout_marginBottom="8dp"/>
        <TextView android:id="@+id/tv_quiz_race"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="16sp" android:textColor="#FFEAEAEA"
            android:layout_marginBottom="8dp"/>
        <TextView android:id="@+id/tv_quiz_clue"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="16sp" android:textColor="#FFEAEAEA"
            android:layout_marginBottom="20dp"/>

        <Button android:id="@+id/btn_qcm_choice_0"
            android:layout_width="match_parent" android:layout_height="56dp"
            android:backgroundTint="#FFB36A" android:textColor="#FF1A1A1A"
            android:layout_marginBottom="10dp"/>
        <Button android:id="@+id/btn_qcm_choice_1"
            android:layout_width="match_parent" android:layout_height="56dp"
            android:backgroundTint="#FFB36A" android:textColor="#FF1A1A1A"
            android:layout_marginBottom="10dp"/>
        <Button android:id="@+id/btn_qcm_choice_2"
            android:layout_width="match_parent" android:layout_height="56dp"
            android:backgroundTint="#FFB36A" android:textColor="#FF1A1A1A"
            android:layout_marginBottom="10dp"/>
        <Button android:id="@+id/btn_qcm_choice_3"
            android:layout_width="match_parent" android:layout_height="56dp"
            android:backgroundTint="#FFB36A" android:textColor="#FF1A1A1A"
            android:layout_marginBottom="10dp"/>

        <LinearLayout android:id="@+id/layout_result"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center"
            android:visibility="gone" android:layout_marginTop="24dp">
            <TextView android:id="@+id/tv_score"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="28sp" android:textStyle="bold" android:textColor="#FFB36A"
                android:layout_marginBottom="20dp"/>
            <Button android:id="@+id/btn_restart"
                android:layout_width="220dp" android:layout_height="56dp"
                android:text="Retour aux quiz" android:backgroundTint="#FFB36A" android:textColor="#FF1A1A1A"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
