<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph"/>

    <!-- Bouton retour, coin supérieur gauche de tous les écrans sauf l'accueil
         (où cet emplacement affiche la version) : remplace la flèche de
         l'ActionBar retirée en V4.3.1. -->
    <TextView android:id="@+id/btn_back"
        android:layout_width="40dp" android:layout_height="40dp"
        android:layout_gravity="top|start" android:layout_margin="16dp"
        android:background="@drawable/bg_help_button"
        android:gravity="center"
        android:text="←" android:textSize="20sp" android:textStyle="bold"
        android:textColor="@color/primary"
        android:contentDescription="Retour"
        android:clickable="true" android:focusable="true"
        android:visibility="gone"/>

    <include layout="@layout/view_achievement_banner"/>

</FrameLayout>
