<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="32dp"
    android:background="@color/surface">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Que souhaitez-vous ajouter ?"
        android:textSize="18sp" android:textColor="@color/on_surface"
        android:layout_marginBottom="48dp"/>

    <Button android:id="@+id/btn_add_entity"
        android:backgroundTint="@color/primary" android:textColor="@color/on_primary"
        android:layout_width="220dp" android:layout_height="56dp"
        android:text="Une Entité" android:layout_marginBottom="24dp"/>

    <Button android:id="@+id/btn_add_place"
        android:backgroundTint="@android:color/transparent" android:textColor="@color/primary" 
        android:layout_width="220dp" android:layout_height="56dp"
        android:text="Un Lieu"/>

</LinearLayout>
