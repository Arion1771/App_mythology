<?xml version="1.0" encoding="utf-8"?>
<!--
  Colonne des trois boutons principaux, partagée par tous les écrans qui en
  comptent trois (accueil, Parcourir, choix du quiz, quiz Lieux, choix du
  domaine). Incluse toujours de la même façon (layout_gravity="center", sans
  marge), afin que les trois boutons tombent au même pixel d'un écran à
  l'autre. Les trois ImageButton ont des dimensions strictement identiques ;
  fitCenter + adjustViewBounds font dériver leur hauteur de l'image (toutes au
  format 1280x720), donc rigoureusement la même pour les trois.
  Cohérence verrouillée par PrimaryButtonPlacementTest (branche Test-Unit).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/primary_button_column"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">

    <ImageButton
        android:id="@+id/btn_primary_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:background="@null"
        android:padding="0dp" />

    <ImageButton
        android:id="@+id/btn_primary_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:background="@null"
        android:padding="0dp" />

    <ImageButton
        android:id="@+id/btn_primary_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:background="@null"
        android:padding="0dp" />

</LinearLayout>
