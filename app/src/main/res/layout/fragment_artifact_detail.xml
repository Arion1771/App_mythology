<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView android:id="@+id/tv_detail_name"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="26sp" android:textStyle="bold"
            android:textColor="#FFEAEAEA" android:layout_marginBottom="4dp"/>

        <TextView android:id="@+id/tv_detail_mythology"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="14sp" android:textColor="#FF9E9E9E"
            android:layout_marginBottom="2dp"/>

        <TextView android:id="@+id/tv_detail_race"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="14sp" android:textColor="#FF9E9E9E"
            android:layout_marginBottom="16dp"/>

        <LinearLayout android:id="@+id/row_owner"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingVertical="6dp" android:visibility="gone">
            <TextView android:layout_width="130dp" android:layout_height="wrap_content"
                android:text="Propriétaire" android:textStyle="bold" android:textSize="13sp" android:textColor="#FF9E9E9E"/>
            <TextView android:id="@+id/tv_detail_owner"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:textSize="13sp" android:textColor="#FFEAEAEA"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/row_creator"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingVertical="6dp" android:visibility="gone">
            <TextView android:layout_width="130dp" android:layout_height="wrap_content"
                android:text="Créateur" android:textStyle="bold" android:textSize="13sp" android:textColor="#FF9E9E9E"/>
            <TextView android:id="@+id/tv_detail_creator"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:textSize="13sp" android:textColor="#FFEAEAEA"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/row_power"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingVertical="6dp" android:visibility="gone">
            <TextView android:layout_width="130dp" android:layout_height="wrap_content"
                android:text="Pouvoir" android:textStyle="bold" android:textSize="13sp" android:textColor="#FF9E9E9E"/>
            <TextView android:id="@+id/tv_detail_power"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:textSize="13sp" android:textColor="#FFEAEAEA"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/row_story"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingVertical="6dp" android:visibility="gone">
            <TextView android:layout_width="130dp" android:layout_height="wrap_content"
                android:text="Histoire" android:textStyle="bold" android:textSize="13sp" android:textColor="#FF9E9E9E"/>
            <TextView android:id="@+id/tv_detail_story"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:textSize="13sp" android:textColor="#FFEAEAEA"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/row_description"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingVertical="6dp" android:visibility="gone">
            <TextView android:layout_width="130dp" android:layout_height="wrap_content"
                android:text="Description" android:textStyle="bold" android:textSize="13sp" android:textColor="#FF9E9E9E"/>
            <TextView android:id="@+id/tv_detail_description"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:textSize="13sp" android:textColor="#FFEAEAEA"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
