<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/surface">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center" android:padding="32dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Duel" android:textSize="24sp" android:textStyle="bold"
            android:textColor="@color/on_surface" android:layout_marginBottom="16dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Nombre de joueurs" android:textSize="16sp"
            android:textColor="@color/on_surface" android:layout_marginBottom="8dp"/>

        <NumberPicker android:id="@+id/number_picker_players"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"/>

        <Button android:id="@+id/btn_duel_players_next"
            android:layout_width="220dp" android:layout_height="56dp"
            android:text="Suivant" android:backgroundTint="@color/primary" android:textColor="@color/on_primary"/>

    </LinearLayout>

    <TextView android:id="@+id/btn_duel_help"
        android:layout_width="40dp" android:layout_height="40dp"
        android:layout_gravity="top|end" android:layout_margin="16dp"
        android:background="@drawable/bg_help_button"
        android:gravity="center"
        android:text="?" android:textSize="18sp" android:textStyle="bold"
        android:textColor="@color/primary"
        android:contentDescription="Aide sur le duel"
        android:clickable="true" android:focusable="true"/>

</FrameLayout>
