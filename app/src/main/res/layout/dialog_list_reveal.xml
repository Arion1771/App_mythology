<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp"
    android:background="@color/surface">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Informations" android:textSize="20sp" android:textStyle="bold"
        android:textColor="@color/on_surface" android:layout_marginBottom="16dp"/>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">
        <TextView android:id="@+id/tv_reveal_info"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="16sp" android:textColor="@color/on_surface_variant"/>
    </ScrollView>

    <Button android:id="@+id/btn_reveal_close"
        android:layout_width="match_parent" android:layout_height="56dp"
        android:text="Retour à la liste" android:backgroundTint="@color/primary"
        android:textColor="@color/on_primary" android:layout_marginTop="16dp"/>

</LinearLayout>
