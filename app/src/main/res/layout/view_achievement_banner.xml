<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_achievement_banner"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_gravity="top"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:background="@color/primary"
    android:paddingHorizontal="16dp" android:paddingVertical="12dp"
    android:elevation="8dp"
    android:visibility="gone">

    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="🏆" android:textSize="20sp"
        android:layout_marginEnd="12dp"/>

    <TextView android:id="@+id/tv_achievement_banner_text"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/on_primary" android:textStyle="bold" android:textSize="15sp"/>

</LinearLayout>
