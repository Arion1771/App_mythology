<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Nom -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Nom *" android:textColor="@color/on_surface_variant"
            android:textSize="12sp" android:layout_marginBottom="4dp"/>
        <EditText android:id="@+id/et_artifact_name"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Ex : Excalibur" android:textColor="@color/on_surface"
            android:textColorHint="@color/on_surface_variant"
            android:backgroundTint="@color/primary"
            android:layout_marginBottom="16dp"/>

        <!-- Mythologie -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Mythologie *" android:textColor="@color/on_surface_variant"
            android:textSize="12sp" android:layout_marginBottom="4dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="16dp">
            <Spinner android:id="@+id/spinner_artifact_mythology"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:backgroundTint="@color/primary"/>
            <Button android:id="@+id/btn_add_artifact_mythology"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="+ Autre"
                android:backgroundTint="@android:color/transparent"
                android:textColor="@color/primary"/>
        </LinearLayout>

        <!-- Type -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Type *" android:textColor="@color/on_surface_variant"
            android:textSize="12sp" android:layout_marginBottom="4dp"/>
        <Spinner android:id="@+id/spinner_artifact_type"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:backgroundTint="@color/primary"
            android:layout_marginBottom="16dp"/>

        <!-- Propriétaire -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Propriétaire" android:textColor="@color/on_surface_variant" android:textSize="12sp" android:layout_marginBottom="4dp"/>
        <EditText android:id="@+id/et_owner"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Ex : Arthur Pendragon" android:textColor="@color/on_surface"
            android:textColorHint="@color/on_surface_variant" android:backgroundTint="@color/primary"
            android:layout_marginBottom="12dp"/>

        <!-- Créateur -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Créateur" android:textColor="@color/on_surface_variant" android:textSize="12sp" android:layout_marginBottom="4dp"/>
        <EditText android:id="@+id/et_creator"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Ex : les nains Sindri et Brokk" android:textColor="@color/on_surface"
            android:textColorHint="@color/on_surface_variant" android:backgroundTint="@color/primary"
            android:layout_marginBottom="12dp"/>

        <!-- Pouvoir -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Pouvoir / Effet" android:textColor="@color/on_surface_variant" android:textSize="12sp" android:layout_marginBottom="4dp"/>
        <EditText android:id="@+id/et_power"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Ex : rend son porteur invincible…" android:textColor="@color/on_surface"
            android:textColorHint="@color/on_surface_variant" android:backgroundTint="@color/primary"
            android:minLines="2" android:gravity="top"
            android:layout_marginBottom="12dp"/>

        <!-- Histoire -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Histoire" android:textColor="@color/on_surface_variant" android:textSize="12sp" android:layout_marginBottom="4dp"/>
        <EditText android:id="@+id/et_artifact_story"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Origine, légende associée…" android:textColor="@color/on_surface"
            android:textColorHint="@color/on_surface_variant" android:backgroundTint="@color/primary"
            android:minLines="2" android:gravity="top"
            android:layout_marginBottom="12dp"/>

        <!-- Description -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Description" android:textColor="@color/on_surface_variant" android:textSize="12sp" android:layout_marginBottom="4dp"/>
        <EditText android:id="@+id/et_artifact_description"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Description libre…" android:textColor="@color/on_surface"
            android:textColorHint="@color/on_surface_variant" android:backgroundTint="@color/primary"
            android:minLines="2" android:gravity="top"
            android:layout_marginBottom="12dp"/>

        <Button android:id="@+id/btn_artifact_save"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Enregistrer"
            android:backgroundTint="@color/primary"
            android:textColor="@color/on_primary"
            android:layout_marginTop="24dp"/>

    </LinearLayout>
</ScrollView>
