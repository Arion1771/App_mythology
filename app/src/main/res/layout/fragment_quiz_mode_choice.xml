<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="32dp"
    android:background="@color/surface">

    <TextView android:id="@+id/tv_mode_choice_title"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="22sp" android:textStyle="bold"
        android:textColor="@color/on_surface" android:layout_marginBottom="48dp"/>

    <Button android:id="@+id/btn_mode_classic"
        android:backgroundTint="@color/primary" android:textColor="@color/on_primary"
        android:layout_width="240dp" android:layout_height="56dp"
        android:text="Classique" android:layout_marginBottom="20dp"/>

    <Button android:id="@+id/btn_mode_qcm"
        android:backgroundTint="@android:color/transparent" android:textColor="@color/primary"
        android:layout_width="240dp" android:layout_height="56dp"
        android:text="QCM"/>

</LinearLayout>
