<?xml version="1.0" encoding="utf-8"?>
<!-- Fond de secours tant qu'aucune image n'est déposée dans
     assets/background/<asset>.png (voir BackgroundAssets), à la manière du
     blason générique de secours des succès : léger halo radial au-dessus de
     la teinte @color/surface actuelle, proche du fond uni existant. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="radial"
        android:gradientRadius="480dp"
        android:centerX="0.5"
        android:centerY="0.3"
        android:startColor="@color/background_theme_default_glow"
        android:endColor="@color/surface"/>
</shape>
